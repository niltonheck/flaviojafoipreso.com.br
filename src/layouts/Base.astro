---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { resolveConfig } from '../lib/config';
import '../styles/global.css';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const cfg = resolveConfig(import.meta.env);
// Absolute URLs come from `site` in astro.config.mjs. Canonical only in production; staging/demo are noindex.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/og-image.png', Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" />
    {cfg.mode !== 'production' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {cfg.mode === 'production' && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Flávio Já Foi Preso?" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Flávio Já Foi Preso? Sátira política." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="hero-page">
    {cfg.mode === 'staging' && <div class="env-banner" role="note">Ambiente de teste — enquete de teste, não é o site oficial</div>}
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="shell">
      <SiteHeader />
      <main id="conteudo"><slot /></main>
      <SiteFooter demo={cfg.mode === 'demo'} pollMode={cfg.pollMode} automation={cfg.automation} />
    </div>
  </body>
</html>
