---
import type { StatusRecord } from '../lib/types';
import { ANSWER_TEXT, type ResolvedStatus } from '../lib/status';

interface Props {
  record: StatusRecord;
  resolved: ResolvedStatus;
  checkedAtLabel: string | null;
  maxAgeHours: number;
  demo: boolean;
}
const { record, resolved, checkedAtLabel, maxAgeHours, demo } = Astro.props;
const status = resolved.status;
const NOTE: Record<string, string> = {
  unverified: 'Ainda sem verificação confiável.',
  'never-checked': 'Ainda sem verificação confiável.',
  stale: 'A última verificação expirou, então a resposta está suspensa.',
};
---
<section
  class="hero"
  aria-labelledby="pergunta"
  data-status={status}
  data-declared-status={record.status}
  data-checked-at={record.checkedAt ?? ''}
  data-max-age-hours={maxAgeHours}
>
  <div class="hero__portrait" aria-hidden="true">
    <img
      src="/images/portrait-480.webp"
      srcset="/images/portrait-320.webp 320w, /images/portrait-480.webp 480w"
      sizes="(min-width: 900px) 160px, 120px"
      alt=""
      width="480"
      height="440"
      decoding="async"
      data-portrait
    />
  </div>
  <h1 id="pergunta" class="hero__question">Flávio Bolsonaro já foi preso?</h1>
  <p class="hero__answer" role="status" data-answer>{ANSWER_TEXT[status]}</p>
  <p class="hero__meta">
    <span data-note>{status === 'unverified' ? NOTE[resolved.reason] : 'Até onde foi possível verificar.'}</span>
    <span class="sep" data-verif-sep aria-hidden="true" hidden={!checkedAtLabel}>·</span>
    <span data-verif hidden={!checkedAtLabel}><span data-verif-label>Última verificação:</span>{' '}<time data-verif-time datetime={record.checkedAt ?? ''}>{checkedAtLabel ? `${checkedAtLabel} (Brasília)` : ''}</time></span>
    <span class="sep" aria-hidden="true">·</span>
    <a href="#sobre">Como verificamos</a>
  </p>
  <p class="hero__sources" data-sources hidden={record.evidence.length === 0}>
    Fontes:{' '}<span data-sources-list>{record.evidence.map((s, i) => (
      <>{i > 0 ? ', ' : ''}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.publisher}</a></>
    ))}</span>
  </p>
  {demo && <p class="hero__demo">Exibição de demonstração — conteúdo local, sem verificação editorial.</p>}
  {status !== 'unverified' && (
    <noscript>
      <p class="hero__demo">
        Status válido em {checkedAtLabel} (Brasília). Ative o JavaScript para confirmar que ele ainda está atualizado.
      </p>
    </noscript>
  )}
</section>

<script>
  // Freshness guard (SPEC C §3): the static HTML cannot age itself, so re-check in the browser.
  // It also applies the automated status served by the Worker (docs/AUTOMATION.md) when available.
  import { ANSWER_TEXT, AUTO_MAX_AGE_HOURS, formatBrasilia, resolveStatus } from '../lib/status';
  import { SITE_EVENT, type SiteData, type SiteEvidence } from '../lib/site';
  import type { ArrestStatus } from '../lib/types';

  // A missing portrait must not break the layout (no inline handlers: the CSP forbids them).
  const img = document.querySelector<HTMLImageElement>('img[data-portrait]');
  const hidePortrait = () => { img!.parentElement!.hidden = true; };
  if (img) {
    if (img.complete && img.naturalWidth === 0) hidePortrait();
    else img.addEventListener('error', hidePortrait, { once: true });
  }

  const hero = document.querySelector<HTMLElement>('.hero[data-declared-status]');
  if (hero) {
    const maxAge = Number(hero.dataset.maxAgeHours);
    const $ = <T extends HTMLElement>(s: string) => hero.querySelector<T>(s)!;

    const apply = (declared: ArrestStatus, checkedAt: string | null, limitHours = maxAge) => {
      const r = resolveStatus(declared, checkedAt, new Date(), limitHours);
      hero.dataset.declaredStatus = declared;
      hero.dataset.checkedAt = checkedAt ?? '';
      hero.dataset.status = r.status;
      $('[data-answer]').textContent = ANSWER_TEXT[r.status];
      $('[data-note]').textContent =
        r.status !== 'unverified' ? 'Até onde foi possível verificar.'
        : r.reason === 'stale' ? 'A última verificação expirou, então a resposta está suspensa.'
        : 'Ainda sem verificação confiável.';
    };

    const showVerification = (checkedAt: string | null, auto: boolean) => {
      const on = checkedAt !== null;
      $('[data-verif]').hidden = !on;
      $('[data-verif-sep]').hidden = !on;
      if (!on) return;
      $('[data-verif-label]').textContent = auto ? 'Verificação automática:' : 'Última verificação:';
      const t = $<HTMLTimeElement>('[data-verif-time]');
      t.dateTime = checkedAt;
      t.textContent = `${formatBrasilia(checkedAt)} (Brasília)`;
    };

    const showSources = (evidence: SiteEvidence[]) => {
      const list = $('[data-sources-list]');
      list.replaceChildren();
      evidence.forEach((e, i) => {
        if (i > 0) list.append(', ');
        const a = document.createElement('a'); // href is https-only: validated by parseSite
        a.href = e.url; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = e.publisher;
        list.append(a);
      });
      $('[data-sources]').hidden = evidence.length === 0;
    };

    // 1) the build-time snapshot, aged against the clock
    apply(hero.dataset.declaredStatus as ArrestStatus, hero.dataset.checkedAt || null);

    // 2) the live automated state, if the Worker served one
    const onSite = (s: SiteData) => {
      apply(s.status.status, s.status.checkedAt, s.status.mode === 'auto' ? AUTO_MAX_AGE_HOURS : maxAge);
      showVerification(s.status.checkedAt, s.status.mode === 'auto');
      showSources(s.status.evidence);
    };
    const early = (window as unknown as { __fjfpSite?: SiteData }).__fjfpSite;
    if (early) onSite(early);
    document.addEventListener(SITE_EVENT, (e) => onSite((e as CustomEvent<SiteData>).detail));
  }
</script>
