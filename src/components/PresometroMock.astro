---
import type { DemoCounts, PollConfig } from '../lib/types';
import { fmtInt } from '../lib/format';

interface Props { poll: PollConfig; demoCounts: DemoCounts }
const { poll, demoCounts: counts } = Astro.props;
const total = counts.yes + counts.no;
const yesPct = total ? Math.round((counts.yes / total) * 100) : 0;
---
<section class="card presometro" data-voted="" aria-labelledby="presometro-titulo" data-poll={JSON.stringify({ id: poll.id, yes: counts.yes, no: counts.no })}>
  <h2 id="presometro-titulo" class="card__title">Presômetro</h2>
  <p class="presometro__question">{poll.question}</p>

  <div class="presometro__buttons" role="group" aria-label="Seu palpite">
    <button type="button" class="vote vote--yes" data-choice="yes" aria-pressed="false">Sim</button>
    <button type="button" class="vote vote--no" data-choice="no" aria-pressed="false">Não</button>
  </div>

  <div class="presometro__result">
    <div class="presometro__labels" aria-live="polite">
      <span class="pct pct--yes"><b data-yes-pct>{yesPct}%</b> sim</span>
      <span class="pct pct--no">não <b data-no-pct>{100 - yesPct}%</b></span>
    </div>
    <div class="bar" role="img" aria-label={`Sim ${yesPct}%, não ${100 - yesPct}%`} data-bar>
      <span class="bar__yes" style={`width:${yesPct}%`}></span>
    </div>
    <p class="presometro__count"><span data-total>{fmtInt(total)}</span> votos simulados</p>
  </div>

  <p class="presometro__error" data-error hidden>Não foi possível carregar a contagem agora.</p>
  <p class="presometro__note" data-note>
    <strong>DEMONSTRAÇÃO</strong> · Enquete informal, sem valor estatístico. Contagem simulada, não é opinião pública real.
  </p>
  <p class="presometro__voted" data-voted-note hidden>Voto de demonstração — não registrado publicamente.</p>
  <noscript><p class="presometro__note">Ative JavaScript para participar.</p></noscript>
</section>

<script>
  import { MockPollRepository } from '../lib/pollRepository';
  import type { Choice, PollResults } from '../lib/pollRepository';

  const root = document.querySelector<HTMLElement>('.presometro[data-poll]');
  if (root) {
    const seed = JSON.parse(root.dataset.poll!) as { id: string; yes: number; no: number };
    const repo = new MockPollRepository(seed);
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const buttons = root.querySelectorAll<HTMLButtonElement>('.vote');
    const fmt = new Intl.NumberFormat('pt-BR');

    const render = (r: PollResults) => {
      const total = r.yes + r.no;
      if (!total) throw new Error('empty');
      const yes = Math.round((r.yes / total) * 100);
      $('[data-yes-pct]').textContent = `${yes}%`;
      $('[data-no-pct]').textContent = `${100 - yes}%`;
      $<HTMLElement>('.bar__yes').style.width = `${yes}%`;
      $('[data-bar]').setAttribute('aria-label', `Sim ${yes}%, não ${100 - yes}%`);
      $('[data-total]').textContent = fmt.format(total);
      $('[data-voted-note]').hidden = r.myVote === null;
      root.dataset.voted = r.myVote ?? '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.choice === r.myVote)));
      $('[data-error]').hidden = true;
    };
    const fail = () => { $('[data-error]').hidden = false; };

    repo.getResults().then(render).catch(fail);
    buttons.forEach((b) =>
      b.addEventListener('click', () => repo.vote(b.dataset.choice as Choice).then(render).catch(fail)),
    );
  }
</script>
