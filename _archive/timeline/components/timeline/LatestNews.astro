---
import type { NewsItem } from '../../lib/timeline/types';
import { fmtShort } from '../../lib/timeline/format';

interface Props { items: NewsItem[] }
const items = Astro.props.items.slice(0, 3);
---
<section class="news" aria-labelledby="news-titulo">
  <h2 id="news-titulo" class="kicker">Últimas notícias <span class="tag">demonstração</span></h2>
  <ol class="news__list">
    {items.map((n) => (
      <li class="news__item">
        <time datetime={n.source.publishedAt}>{fmtShort(n.source.publishedAt)}</time>
        <span class="news__title">
          {n.source.url ? <a href={n.source.url} rel="noopener noreferrer" target="_blank">{n.title}</a> : n.title}
        </span>
        <span class="news__src">{n.source.publisher}</span>
      </li>
    ))}
  </ol>
</section>
