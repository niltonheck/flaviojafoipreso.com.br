{
  // Local/dev configuration. Staging and production environments (separate D1 databases,
  // secrets and routes) are added in PR 3.
  "name": "flaviojafoipreso",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the poll API runs Worker code; everything else is served straight from the CDN.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fjfp-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Per-IP and per-voter vote limits. Verify quotas/pricing at deploy time (SPEC C §7).
  "ratelimits": [
    { "name": "VOTE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
