{
  // Top level = LOCAL development (`wrangler dev`, local D1). See docs/DEPLOY.md.
  // Named environments do not inherit bindings, so staging/production repeat them explicitly.
  "name": "flaviojafoipreso",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the poll API runs Worker code; everything else is served straight from the CDN.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // 05:00 UTC (02:00 Brasília): vote-code retention. Every hour: automated editorial job (docs/AUTOMATION.md), which stays
  // inert unless AUTOMATION_ENABLED is "true". Secrets (never in git): GEMINI_API_KEY, ALERT_TO.
  "triggers": { "crons": ["0 5 * * *", "0 * * * *"] },
  "vars": { "AUTOMATION_ENABLED": "false", "GEMINI_MODEL": "gemini-3.8-flash", "ALERT_FROM": "alertas@flaviojafoipreso.com.br" },
  "send_email": [{ "name": "ALERTS" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fjfp-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "VOTE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],

  "env": {
    // Non-public test deployment on workers.dev: fake poll id, noindex, test banner, its own D1.
    "staging": {
      "name": "flaviojafoipreso-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
      "triggers": { "crons": ["0 5 * * *", "0 * * * *"] },
  "vars": { "AUTOMATION_ENABLED": "false", "GEMINI_MODEL": "gemini-3.8-flash", "ALERT_FROM": "alertas@flaviojafoipreso.com.br" },
  "send_email": [{ "name": "ALERTS" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fjfp-staging",
          "database_id": "496c457e-5f50-436f-9484-9650b45bc37c",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "VOTE_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }
      ]
    },

    // Real site. Domain assumption: apex flaviojafoipreso.com.br (www redirects to it via a Cloudflare
    // Redirect Rule, see docs/DEPLOY.md). Deployment scripts for this environment arrive in PR 4.
    "production": {
      "name": "flaviojafoipreso",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "flaviojafoipreso.com.br", "custom_domain": true }],
      "observability": { "enabled": true },
      "triggers": { "crons": ["0 5 * * *", "0 * * * *"] },
  "vars": { "AUTOMATION_ENABLED": "true", "GEMINI_MODEL": "gemini-3.8-flash", "ALERT_FROM": "alertas@flaviojafoipreso.com.br" },
  "send_email": [{ "name": "ALERTS" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fjfp-production",
          "database_id": "542ca32c-2437-492e-8913-24681076a9ee",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "VOTE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
